{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeHub",
  "version": "1.0.0",
  "identifier": "de.lifehub.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LifeHub",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.png"],
    "copyright": "© Erik",
    "category": "Productivity",
    "shortDescription": "Persönliche Finanz-, Planungs- und Tracking-App",
    "longDescription": "LifeHub verbindet Finanzen, Aufgaben, Termine, Ernährung, Training, Schlaf und Körperdaten in einer Anwendung. Alle Daten bleiben lokal.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"]
      }
    }
  }
}
